{
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "PASS_R6_NEXT_JOB",
        "MUST_FIX"
      ]
    },
    "parent_decision_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "string",
      "maxLength": 4096
    },
    "evidence_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 32
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 0
    },
    "must_fix": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048
      },
      "maxItems": 32
    }
  },
  "required": [
    "decision",
    "parent_decision_sha256",
    "plan_sha256",
    "summary",
    "evidence_pins",
    "changed_files",
    "must_fix"
  ],
  "additionalProperties": false
}
