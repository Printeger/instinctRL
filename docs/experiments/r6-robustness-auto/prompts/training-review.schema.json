{
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "PASS_R6_TRAINING_REVIEW",
        "MUST_FIX"
      ]
    },
    "summary": {
      "type": "string"
    },
    "evidence_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 0
    },
    "next_plan": {
      "type": "string"
    },
    "remaining_budget": {
      "type": "object",
      "properties": {
        "automatic_sessions_remaining": {
          "type": "integer"
        }
      },
      "required": [
        "automatic_sessions_remaining"
      ],
      "additionalProperties": false
    },
    "must_fix": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "recipe",
              "capacity",
              "compatibility",
              "freeze"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "PASS_R6_TRAINING_RECIPE",
              "PASS_R6_TRAINING_CAPACITY",
              "PASS_R6_TRAINING_COMPATIBILITY",
              "MUST_FIX",
              "PASS_R6_RECIPE_FREEZE"
