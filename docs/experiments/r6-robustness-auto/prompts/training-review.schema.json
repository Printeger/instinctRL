          },
          "reviewer": {
            "type": "string",
            "const": "r6-independent-training-review"
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "summary": {
            "type": "string",
            "maxLength": 4096
          },
          "must_fix": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048
            },
            "maxItems": 32
