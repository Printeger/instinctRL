{
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "NEEDS_REPAIR",
        "PROPOSE_CANDIDATE",
        "PROPOSE_CONFIRMATION",
        "PROPOSE_BASELINE_VALIDATION",
        "REQUEST_FINAL_REVIEW"
      ]
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "string",
      "maxLength": 4096
    },
    "evidence_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 32
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 0
    },
    "must_fix": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      },
      "maxItems": 32
    },
    "remaining_budget": {
      "type": "object",
      "properties": {
        "automatic_sessions_remaining": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "automatic_sessions_remaining"
      ],
      "additionalProperties": false
    },
    "next_plan": {
      "type": "object",
      "properties": {
        "hypothesis": {
          "type": "string",
          "maxLength": 2048
        },
        "comparison": {
          "type": "string",
          "maxLength": 2048
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          },
          "minItems": 1,
          "maxItems": 8
        },
        "independent_review_required": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "hypothesis",
        "comparison",
        "steps",
        "independent_review_required"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "decision",
    "packet_sha256",
    "summary",
    "evidence_pins",
    "changed_files",
    "must_fix",
    "remaining_budget",
    "next_plan"
  ],
  "additionalProperties": false
}
