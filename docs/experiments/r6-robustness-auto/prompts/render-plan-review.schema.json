{
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "PASS_R6_RENDER_PLAN",
        "MUST_FIX"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 4096
    },
    "evidence_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 0
    },
    "must_fix": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048
      },
      "maxItems": 32
    },
    "remaining_budget": {
      "type": "object",
      "properties": {
        "automatic_sessions_remaining": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "automatic_sessions_remaining"
      ],
      "additionalProperties": false
    },
    "reviewer": {
      "type": "string",
      "const": "r6-independent-render-plan"
    },
    "preparation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "decision",
    "summary",
    "evidence_pins",
    "changed_files",
    "must_fix",
    "remaining_budget",
    "reviewer",
    "preparation_sha256",
    "payload_sha256"
  ],
  "additionalProperties": false
}
