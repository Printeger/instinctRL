{
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "SOURCE_READY",
        "PREPARATION_INCOMPLETE"
      ]
    },
    "parent_decision_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "string",
      "maxLength": 4096
    },
    "source_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "config": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "card": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 128
    },
    "must_fix": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048
      },
      "maxItems": 32
    },
    "remaining_budget": {
      "type": "object",
      "properties": {
        "automatic_sessions_remaining": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "automatic_sessions_remaining"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "decision",
    "parent_decision_sha256",
    "summary",
    "source_commit",
    "config",
    "card",
    "evidence_pins",
    "changed_files",
    "must_fix",
    "remaining_budget"
  ],
  "additionalProperties": false
}
